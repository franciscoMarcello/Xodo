{
  "name": "painel-pc",
  "productName": "Xodó",
  "version": "0.11.0",
  "private": true,
  "description": "Xodó: cuida do seu PC. Status, alertas, travamentos, jogos, drivers, limpeza, internet e energia.",
  "author": "Francisco Marcello",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/main/alerts/detectors.test.mts src/main/history/aggregate.test.mts src/main/gamesdb/gamesdb.test.mts src/main/bottleneck.test.mts src/main/drivers/drivers.test.mts src/main/optimize/optimize.test.mts src/main/diskhealth.test.mts src/main/crashes/crashes.test.mts src/main/netlag/netlag.test.mts src/main/gamemode.test.mts"
  },
  "build": {
    "appId": "br.painel-pc",
    "productName": "Xodó",
    "executableName": "Xodo",
    "artifactName": "Xodo-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Xodó",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "typescript": "5.9",
    "vite": "^8.3.4"
  }
}
